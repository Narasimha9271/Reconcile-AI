# Local development configuration. Copy this file to .env.
# Populate these values with your own Google OAuth credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
# Comma-separated approved sign-in addresses.
GOOGLE_ALLOWED_EMAIL=
# Comma-separated subset allowed to approve or reject invoices.
GOOGLE_FINANCE_APPROVER_EMAILS=
# Replace with a long, randomly generated value before signing in.
SESSION_SECRET=

# Optional: enables OpenAI extraction. Keep real keys out of Git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
